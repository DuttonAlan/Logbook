<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the tests of Logbook.Sdk.Tests against the netstandard2.0 build of the SDK, which a net10.0 test project would
       otherwise never load. It runs on .NET 10, so it covers the code of that build, not .NET Framework itself.
       SdkBuildTests checks that the right build was loaded. -->

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);SDK_NETSTANDARD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Logbook.Sdk.Tests\**\*.cs" Exclude="..\Logbook.Sdk.Tests\bin\**;..\Logbook.Sdk.Tests\obj\**" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <!-- The netstandard2.0 build references this assembly, which on .NET 10 forwards to the built-in type. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\Logbook.Sdk\Logbook.Sdk.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
