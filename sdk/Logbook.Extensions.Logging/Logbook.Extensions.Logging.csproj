<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Description>Microsoft.Extensions.Logging (ILogger) provider that sends log events to Logbook.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Logbook.Sdk.Tests" />
    <InternalsVisibleTo Include="Logbook.Sdk.Tests.NetStandard" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logbook.Sdk\Logbook.Sdk.csproj" />
  </ItemGroup>

</Project>
